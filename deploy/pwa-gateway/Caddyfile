{
	auto_https disable_redirects
	https_port 8443
	servers {
		protocols h1 h2
	}
}

bb.staufingers.de {
	bind 127.0.0.1
	tls {
		issuer acme {
			disable_http_challenge
			alt_tlsalpn_port 8443
		}
	}

	encode zstd gzip

	@authelia path /authelia /authelia/*
	handle @authelia {
		reverse_proxy 127.0.0.1:9091
	}

	# This loopback-only enrollment-key endpoint must never inherit the FRP
	# visitor's NAS-side loopback address.
	@bb_internal_enroll_key path /internal/hosts/enroll-key
	handle @bb_internal_enroll_key {
		respond 404
	}

	# Desktop execution helpers use the coordinator's daemon transport. Admit
	# only paired daemon-shaped requests here; the coordinator still verifies
	# the bearer host key (or one-time enrollment token) on every request.
	@bb_internal_daemon {
		path /internal /internal/*
		header Authorization "Bearer *"
		header X-Bb-Connect-Machine *
	}
	handle @bb_internal_daemon {
		reverse_proxy 127.0.0.1:38886
	}

	# Never fall through to Authelia or the SPA for any other internal request.
	@bb_internal path /internal /internal/*
	handle @bb_internal {
		respond 404
	}

	# Native execution hosts and their local CLI proxy cannot use an Authelia
	# browser cookie. Admit only the narrow coordinator surface when both the
	# paired-machine credential and daemon host key are present; BB validates the
	# host key before any matched request reaches its route handler.
	@bb_native_client {
		path /api /api/* /ws /ws/* /install/version /install/bb-app.tgz /health
		header Authorization "Bearer *"
		header X-Bb-Connect-Machine *
	}
	handle @bb_native_client {
		reverse_proxy 127.0.0.1:38886
	}

	@bb_dynamic path /api /api/* /ws /ws/* /install.sh /install/* /health

	handle {
		route {
			forward_auth 127.0.0.1:9091 {
				uri /api/authz/forward-auth?authelia_url=https://bb.staufingers.de/authelia/
				copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
			}

			reverse_proxy @bb_dynamic 127.0.0.1:38886

			root * /srv/bb-pwa/current
			try_files {path} /index.html
			file_server {
				precompressed br gzip
			}
		}
	}
}
