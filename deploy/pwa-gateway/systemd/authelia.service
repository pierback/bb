[Unit]
Description=Authelia for the BB remote PWA
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=authelia
Group=authelia
WorkingDirectory=/var/lib/authelia
Environment=AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET_FILE=/etc/authelia/secrets/JWT_SECRET
Environment=AUTHELIA_SESSION_SECRET_FILE=/etc/authelia/secrets/SESSION_SECRET
Environment=AUTHELIA_STORAGE_ENCRYPTION_KEY_FILE=/etc/authelia/secrets/STORAGE_ENCRYPTION_KEY
ExecStart=/usr/local/bin/authelia --config /etc/authelia/configuration.yml
Restart=on-failure
RestartSec=5s

NoNewPrivileges=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/authelia
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
