{
  "name": "bb-plugin-session-fabric",
  "version": "0.1.0",
  "description": "Inspect and operate BB's portable provider sessions from a thread panel and CLI.",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/pierback/bb#readme",
  "bugs": {
    "url": "https://github.com/pierback/bb/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pierback/bb.git",
    "directory": "plugins/session-fabric"
  },
  "type": "module",
  "files": [
    "dist",
    "server.ts",
    "app.tsx",
    "connection-details.tsx",
    "README.md"
  ],
  "engines": {
    "bb": ">=0.0",
    "bbPluginSdk": "^0.4.1"
  },
  "bb": {
    "name": "Session Fabric",
    "description": "Inspect and operate portable provider sessions without moving runtime authority out of BB core.",
    "branding": {
      "icon": "Workflow"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "keywords": [
    "bb-plugin",
    "sessions",
    "orchestration"
  ],
  "scripts": {
    "build": "node --conditions=source --import tsx ../../scripts/build-official-plugins.mjs session-fabric",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@bb/shared-ui": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@bb/plugin-sdk": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "^4.1.1"
  }
}
